# Firebase Authentication, clinician accounts only. Patient data stays on the phone.
# Create a Firebase project, enable Email/Password, then paste the web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Leave unset for the clinician app. The Batch 3 build script sets this to 0.
EXPO_PUBLIC_AUTH_REQUIRED=1
