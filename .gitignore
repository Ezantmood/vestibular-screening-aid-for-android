# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local Expo module Gradle outputs
modules/*/android/build/
modules/*/android/.cxx/
modules/*/android/.gradle/

# P2/P3 debug artifacts guard: recorded videos / face images / pupil overlays
# pulled off-device for inspection must never be committed (debug JPEGs stay
# in device-local app cache `framedebug/` / `pupildebug/`; this is a backstop
# for anything copied into the repo).
*.mp4
*.avi
*.mov
debug-artifacts/
framedebug/
pupildebug/
